<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/profilerggg"
        android:layout_width="@dimen/_25sdp"
        android:layout_height="@dimen/_25sdp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/_5sdp"
        android:layout_marginEnd="@dimen/_10sdp"
        android:layout_marginBottom="@dimen/_5sdp"
        android:src="@drawable/photocamera" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end"
        android:layout_toStartOf="@id/profilerggg"
        android:layout_toLeftOf="@id/profilerggg"
        android:layout_marginStart="@dimen/_40sdp"
        android:layout_marginEnd="@dimen/_4sdp"
        android:layout_marginTop="@dimen/_4sdp"
        android:layout_marginBottom="@dimen/_4sdp">

        <ImageView
            android:id="@+id/sender_img_msg"
            android:layout_width="@dimen/_160sdp"
            android:layout_height="@dimen/_160sdp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:background="@drawable/sender_shape"
            android:padding="@dimen/_4sdp" />

        <TextView
            android:id="@+id/msgsendertyp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/sender_shape"
            android:fontFamily="@font/poppins_regular"
            android:padding="@dimen/_7sdp"
            android:text="message"
            android:textColor="@color/black"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/msgsendertime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12:00 PM"
            android:textColor="#555555"
            android:textSize="@dimen/_8sdp"
            android:fontFamily="@font/poppins_regular"
            android:layout_marginEnd="@dimen/_2sdp"
            android:layout_marginTop="@dimen/_1sdp"/>

    </LinearLayout>

</RelativeLayout>