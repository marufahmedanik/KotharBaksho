<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="4dp"
    android:paddingEnd="48dp"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:gravity="start"
        android:orientation="vertical">

        <!-- Speech Bubble with Asymmetrical Tail Corner -->
        <LinearLayout
            android:id="@+id/reciver_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/reciver_shape"
            android:elevation="1.5dp"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="9dp"
            android:paddingEnd="14dp"
            android:paddingBottom="9dp">

            <ImageView
                android:id="@+id/reciver_img_msg"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_marginBottom="4dp"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <TextView
                android:id="@+id/recivertextset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:text="Receiver message text"
                android:textColor="@color/receiver_bubble_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/recivertime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/poppins_regular"
                android:text="12:00 PM"
                android:textColor="@color/receiver_bubble_time"
                android:textSize="10sp" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>